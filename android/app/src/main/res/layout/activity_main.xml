<?xml version="1.0" encoding="utf-8"?>
<!-- Main WebView host: full-window WebView (edge-to-edge, spans the foldable hinge)
     plus thin wrapper chrome (cleartext warning banner, offline chip, overflow menu,
     connection-error panel). The PWA owns everything else. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dsh_background">

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dsh_background" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/dsh_accent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/top_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/warning_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/dsh_warning_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="56dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/warning_cleartext"
                android:textColor="@color/dsh_warning_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/warning_dismiss"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/warning_cleartext_action"
                android:textColor="@color/dsh_warning_text"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/offline_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/offline_chip"
            android:textColor="@color/dsh_text_primary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/menu_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_menu_button"
        android:contentDescription="@string/menu_content_description"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="&#8942;"
        android:textColor="@color/dsh_text_primary"
        android:textSize="22sp" />

    <LinearLayout
        android:id="@+id/error_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/error_panel_horizontal_padding"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/error_panel_horizontal_padding"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_panel_title"
            android:textColor="@color/dsh_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/error_panel_detail_default"
            android:textColor="@color/dsh_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/error_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/error_panel_retry" />

            <Button
                android:id="@+id/error_change_pc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/error_panel_change_pc" />
        </LinearLayout>

        <Button
            android:id="@+id/error_offline"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/error_panel_offline"
            android:textColor="@color/dsh_accent"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>

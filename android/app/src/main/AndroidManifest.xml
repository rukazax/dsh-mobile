<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The wrapper talks only to the user's DSH host on the LAN.
         No camera, storage or location permissions are declared in v1
         (pairing is done by typing the code or by opening a dshm:// link). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DshMobile"
        android:usesCleartextTraffic="true">

        <!-- Single WebView host. resizeableActivity + configChanges are what make the
             activity survive folding/unfolding: the same WebView instance spans the
             hinge, and the PWA does segment layout in CSS. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- dshm://pair?url=http%3A%2F%2F192.168.1.10%3A3081&code=ABCD1234
                 Opened by any QR scanner app / link, prefills the pairing screen. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pair"
                    android:scheme="dshm" />
            </intent-filter>
        </activity>

        <!-- No WebView state to preserve here, so folding may recreate this screen.
             It has no configChanges on purpose: re-inflation keeps the large-screen
             dimensions correct. -->
        <activity
            android:name=".PairingActivity"
            android:exported="false"
            android:label="@string/pairing_title"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
